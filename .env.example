# Copy this file to `.env` and fill in your key.
# `.env` is gitignored — never commit it.
#
#   cp .env.example .env
#   $EDITOR .env
#
# The MT-Bench judge script auto-loads .env from the repo root.

OPENAI_API_KEY=sk-replace-me

# Optional hard cap (USD) for judge_mtbench.py. CLI --budget overrides this.
MTBENCH_BUDGET_USD=5.0
